
<html lang='pt-BR'>
  <head>
    <meta charset='UTF-8' />
    <title>Sistema Escolar - Servidores</title>
    <link rel='stylesheet' href='/css/styleS.css' />
  </head>
  <body>

    <main class='container'>

      <h1>Sistema Escolar</h1>
      <h2>Cadastro de Servidor</h2>

      <label for='nome'>Nome</label>
      <input type='text' id='nome' placeholder='Nome' autocomplete='name' />

      <label for='email'>E-mail institucional</label>
      <input type='email' id='email' placeholder='E-mail institucional' autocomplete='email' />

      <label for='senha'>Senha</label>
      <input type='password' id='senha' placeholder='Senha' autocomplete='new-password' />

      <button onclick='salvar()'>Salvar Conta</button>

      <table>
        <thead>
          <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Ações</th>
          </tr>
        </thead>

        <tbody id='tabela'></tbody>

      </table>

    </main>

    <script src='/js/script.js'></script>

  </body>
</html>
